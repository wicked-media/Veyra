# ---------------------------------------------------------------------------
# Veyra environment configuration
# Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------

# Canonical origin of the application. Used for cookie security, same-origin
# checks on state-changing requests, and the OIDC redirect URI.
VEYRA_APP_URL=http://localhost:3000

# Production / external PostgreSQL. When set, this takes precedence over the
# embedded local database.
# DATABASE_URL=postgresql://veyra:veyra@localhost:5432/veyra

# Local development database directory (embedded PostgreSQL via PGlite).
# Leave unset to use <repo>/.data/pglite. Set VEYRA_AUTO_SEED=false to skip
# the demo firm seed on an empty local database.
VEYRA_DB_DIR=.data/pglite
# VEYRA_AUTO_SEED=true

# ---------------------------------------------------------------------------
# Production identity (required when NODE_ENV=production)
#
# Production forces OIDC even if VEYRA_AUTH_MODE=local is set. The issuer must
# publish /.well-known/openid-configuration and a JWKS endpoint. The account
# must already have been invited to the firm; OIDC never auto-provisions users.
# MFA is required by default and is checked from the configured assurance claim.
# ---------------------------------------------------------------------------
# VEYRA_AUTH_MODE=oidc
# VEYRA_OIDC_ISSUER=https://login.example.com/tenant/v2.0
# VEYRA_OIDC_CLIENT_ID=
# Optional for a confidential client; PKCE is always used.
# VEYRA_OIDC_CLIENT_SECRET=
# Defaults to ${VEYRA_APP_URL}/api/auth/oidc/callback
# VEYRA_OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# VEYRA_OIDC_LABEL=firm identity provider
# VEYRA_OIDC_REQUIRE_MFA=true
# VEYRA_OIDC_MFA_CLAIM=amr
# VEYRA_OIDC_MFA_VALUES=mfa,otp,hwk,swk
# Only enable for an issuer that supplies a verified email claim.
# VEYRA_OIDC_TRUST_EMAIL=false

# ---------------------------------------------------------------------------
# Private document storage and malware scanning
#
# Development uses a private local directory. Production must provide a durable
# private volume or replace the storage adapter with encrypted object storage.
# Production upload fails closed unless VEYRA_MALWARE_SCANNER_URL is configured.
# ---------------------------------------------------------------------------
# VEYRA_DOCUMENT_DIR=.data/documents
# VEYRA_MALWARE_SCANNER_URL=
# VEYRA_MALWARE_SCANNER_TOKEN=

# ---------------------------------------------------------------------------
# AI provider
#
# Local development uses the explicitly labelled extractive preview when no
# key is present. Production is disabled without OPENAI_API_KEY; there is no
# silent mock fallback. The model is allowlisted server-side.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# VEYRA_AI_MODEL=gpt-4.1-mini
# VEYRA_AI_ENABLED=true
# VEYRA_AI_LOCAL=true

# ---------------------------------------------------------------------------
# Optional integrations (Stage 5+). Empty values keep the integration
# visibly disconnected; no feature silently falls back to a mock service.
# ---------------------------------------------------------------------------
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# MYOB_CLIENT_ID=
# MYOB_CLIENT_SECRET=
